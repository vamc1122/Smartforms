    CLEAR : tot_copy,no_copy.
    no_copy = 1.
    DESCRIBE TABLE it_table LINES tot_copy.

    SORT it_table BY pkkey.
    LOOP AT it_table INTO DATA(wa_table).

      DATA(lv_tabix) = sy-tabix.

      lv_num = 2.
      CONCATENATE wa_table-pkkey lv_num INTO lv_barcode .
      READ TABLE it_makt INTO DATA(wa_makt) WITH KEY matnr = wa_table-matnr.
      READ TABLE it_pvkt INTO DATA(wa_pvkt) WITH KEY prvbe = wa_table-prvbe.

      no_copy = no_copy.
      w_cnt = tot_copy.
      w_cnt2 = lv_tabix.
