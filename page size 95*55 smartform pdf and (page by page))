FORM get_process_data.

  SELECT a~werks,
         a~prvbe,
         a~lgort,  " storage location
         b~pknum,  "
         b~matnr,  " material
         b~meins,  " uom
         b~behaz,  "
         b~behmg,  " qty
         c~pkkey,   " kanban id
         c~pkpos   " container
  FROM pvbe AS a
  INNER JOIN pkhd AS b
  ON a~werks = b~werks
  AND a~prvbe = b~prvbe
  INNER JOIN pkps AS c
  ON b~pknum = c~pknum
  INTO CORRESPONDING FIELDS OF TABLE @it_table
  WHERE a~werks = @p_werks
  AND   a~lgort = @p_lgort
  AND   a~prvbe = @p_psa
  AND   b~matnr IN @s_mat
  AND   c~pkkey IN @s_kanban.


  IF it_table IS NOT INITIAL.
    SELECT matnr,
           maktx  " material decription
      FROM makt INTO TABLE @DATA(it_makt)
      FOR ALL ENTRIES IN @it_table
      WHERE matnr = @it_table-matnr.

    SELECT pvbtx,  " psa_decription
           prvbe   " psa
      FROM pvkt INTO TABLE @DATA(it_pvkt)
      FOR ALL ENTRIES IN @it_table
      WHERE prvbe = @it_table-prvbe.

  ENDIF.


